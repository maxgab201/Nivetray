<Window x:Class="Nivetray.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nivetray" Width="1020" Height="720" MinWidth="760" MinHeight="520"
 WindowStartupLocation="CenterScreen" Closing="OnClosing" Icon="Assets/Nivetray.ico">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22">
   <Border DockPanel.Dock="Left" Background="#6250BB" CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0"><TextBlock Text="N" Foreground="White" FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <Button DockPanel.Dock="Right" Content="Send Nivetray to tray" Click="SendToTray" HorizontalAlignment="Right"/>
   <StackPanel><TextBlock Text="Nivetray" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Keep it running. Keep it hidden." Foreground="#72778B"/></StackPanel>
  </DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,18"><TextBlock Text="Search windows" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBox x:Name="Search" AutomationProperties.Name="Search windows" ToolTip="Search by window title, application name or executable path" TextChanged="SearchChanged"/></DockPanel>
  <TabControl x:Name="Tabs" Grid.Row="2" Background="White" BorderBrush="#E0E3EC">
   <TabItem Header="Available windows">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshClicked"/><StackPanel><TextBlock Text="Your running applications" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Select a window, then hide it. Each window is managed separately." Foreground="#72778B" TextWrapping="Wrap"/></StackPanel></DockPanel>
     <ListView x:Name="AvailableList" Grid.Row="1" BorderThickness="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Available windows">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate><Grid Margin="4,8"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="26" Height="26" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Window.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#72778B" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Window.ExecutablePath}" Foreground="#72778B" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="HideButton" DockPanel.Dock="Right" Content="Hide selected window" Click="HideSelected" Background="#6250BB" Foreground="White"/><Button DockPanel.Dock="Right" Content="Remember application" Click="RememberSelected"/><TextBlock x:Name="AvailableCount" VerticalAlignment="Center" Foreground="#72778B" TextWrapping="Wrap"/></DockPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Hidden windows">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,14"><TextBlock Text="Out of sight. Still running." FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Search above to find a hidden window. Restore it here or from the tray menu." Foreground="#72778B" TextWrapping="Wrap"/></StackPanel>
     <ListView x:Name="HiddenList" Grid.Row="1" BorderThickness="0" DisplayMemberPath="Window.Title" AutomationProperties.Name="Hidden windows"/>
     <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Restore selected" Click="RestoreSelected"/><Button Content="Restore all" Click="RestoreAll"/></StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
     <TextBlock Text="Make room for what matters" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <CheckBox x:Name="CloseToTray" Content="Keep Nivetray in the tray when I close this window" Checked="ClosePreferenceChanged" Unchecked="ClosePreferenceChanged" Margin="0,0,0,18"/>
     <TextBlock Text="Application rules" FontWeight="SemiBold"/>
     <TextBlock Text="Manage remembers an app. Include also allows its owned or tool windows. Exclude removes it from detection. Rules never hide windows automatically." TextWrapping="Wrap" Foreground="#72778B" Margin="0,6,0,12"/>
     <ListBox x:Name="RulesList" DisplayMemberPath="Display" Height="135"/>
     <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RulePath" AutomationProperties.Name="Executable path" ToolTip="Full path to an executable"/><ComboBox x:Name="RuleModeBox" Grid.Column="1" Margin="8,0" VerticalContentAlignment="Center"/><Button Grid.Column="2" Content="Save rule" Click="SaveRule"/></Grid>
     <Button Content="Remove selected rule" Click="RemoveRule" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     <TextBlock Text="Local by design" FontWeight="SemiBold" Margin="0,24,0,6"/>
     <TextBlock Text="No telemetry, accounts or network requests. Settings contain only your preferences and executable rules. Diagnostic logs exclude window titles and executable paths." TextWrapping="Wrap" Foreground="#72778B"/>
     <TextBlock x:Name="SettingsLocation" TextWrapping="Wrap" Foreground="#72778B" FontSize="12" Margin="0,10,0,12"/>
     <Button Content="Restore all and exit Nivetray" Click="ExitClicked" HorizontalAlignment="Left"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <TextBlock x:Name="Status" Grid.Row="3" Text="Ready. Hiding a window keeps its application running." Foreground="#62687B" Margin="0,16,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
